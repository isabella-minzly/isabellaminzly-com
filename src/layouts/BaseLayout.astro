---
// Page shell from the Figma pages: green brand bar, sidebar (Logo and NavigationMenu) from 1280,
// main content and Footer. Below 1280 a header with a menu button opens the navigation in an
// overlay (frames "Landing page / 1024 / Menu open" and "Landing page / Mobile 320 / Menu open").
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import NavigationMenu from '../components/NavigationMenu.astro';
import IconButton from '../components/IconButton.astro';
import Footer from '../components/Footer.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { url } from '../utils/url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex: pageNoindex = false } = Astro.props;
// The preview build sets PUBLIC_NOINDEX so search engines do not list the temporary address
const noindex = pageNoindex || import.meta.env.PUBLIC_NOINDEX === 'true';
const fullTitle = title === 'Isabella Minzly' ? title : `${title} | Isabella Minzly`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={url('/fonts/instrument-sans.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/instrument-serif.woff2')} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      // A theme the visitor chose with the switch wins over the system setting. Runs before the page paints.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <div class="page">
      <div class="page__content">
        <header class="site-header">
          <Logo />
          <IconButton class="menu-open" icon="menu" label="Menu" aria-haspopup="dialog" aria-controls="menu-dialog" />
        </header>
        <header class="sidebar">
          <div class="sidebar__logo"><Logo /></div>
          <nav class="sidebar__nav" aria-label="Main">
            <NavigationMenu currentPath={Astro.url.pathname} />
          </nav>
          <ThemeSwitch />
        </header>
        <main class="main" id="main" tabindex="-1">
          <slot />
        </main>
      </div>
      <Footer />
    </div>

    <dialog class="menu-dialog" id="menu-dialog" aria-label="Menu">
      <div class="menu-dialog__header">
        <Logo />
        <IconButton class="menu-close" icon="close" label="Close menu" />
      </div>
      <nav aria-label="Main">
        <NavigationMenu currentPath={Astro.url.pathname} />
      </nav>
      <ThemeSwitch />
    </dialog>

    <script>
      // Menu overlay below 1280: a modal dialog, so focus stays inside and Escape closes it.
      const dialog = document.querySelector<HTMLDialogElement>('#menu-dialog');
      const openButton = document.querySelector<HTMLButtonElement>('.menu-open');
      const closeButton = document.querySelector<HTMLButtonElement>('.menu-close');
      if (dialog && openButton && closeButton) {
        openButton.addEventListener('click', () => dialog.showModal());
        closeButton.addEventListener('click', () => dialog.close());
        dialog.addEventListener('close', () => openButton.focus());
        // A click outside the panel lands on the backdrop, which belongs to the dialog element
        dialog.addEventListener('click', (event) => {
          const r = dialog.getBoundingClientRect();
          const outside = event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom;
          if (event.target === dialog && outside) dialog.close();
        });
        // Growing past 1280 shows the sidebar, so the overlay is no longer needed
        matchMedia('(width >= 80em)').addEventListener('change', (event) => {
          if (event.matches && dialog.open) dialog.close();
        });
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-block-start: var(--space_8);
    inset-inline-start: var(--space_16);
    z-index: 10;
    padding: var(--space_12) var(--space_24);
    border-radius: var(--radius_xl);
    background: var(--accent_default);
    color: var(--text_label);
    font-family: var(--label-font-family);
    font-stretch: var(--label-font-stretch);
    font-weight: var(--label-font-weight);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
    outline: var(--border_focus) solid var(--accent_default);
    outline-offset: var(--space_2);
  }

  /* Green brand bar: full page height on the left edge */
  .page {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space_16);
    max-inline-size: var(--page-max-width);
    padding-inline-start: var(--brand-bar-width);
  }

  .page::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: var(--brand-bar-width);
    background: var(--decorative_brand);
  }

  /* Sections lay themselves out by the space in Main, not the window width */
  .main {
    container: main / inline-size;
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }

  .main:focus {
    outline: none;
  }

  /* Below 1280: header with the menu button, content full width */
  .page__content {
    display: flex;
    flex-direction: column;
    gap: var(--space_16);
    padding: 0 var(--space_16) var(--space_32);
  }

  @media (width >= 47.5em) {
    .page__content {
      padding-inline: var(--space_32);
    }
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space_16);
  }

  .sidebar {
    display: none;
  }

  /* Without JavaScript the menu button cannot open the overlay, so the menu is listed instead */
  html:not(.js) .menu-open {
    display: none;
  }

  html:not(.js) .sidebar {
    display: block;
  }

  html:not(.js) .sidebar__logo {
    display: none;
  }

  /* From 1280: fixed sidebar, fluid content, left-anchored up to 1680.
     As in Figma, the brand bar overlaps the sidebar instead of pushing it. */
  @media (width >= 80em) {
    .page {
      padding-inline-start: 0;
    }

    .page__content {
      flex-direction: row;
      gap: var(--space_24);
      padding: 0 0 var(--space_24);
    }

    .site-header {
      display: none;
    }

    .sidebar,
    html:not(.js) .sidebar {
      flex: none;
      display: flex;
      flex-direction: column;
      gap: var(--space_12);
      inline-size: var(--sidebar-width);
    }

    html:not(.js) .sidebar__logo {
      display: block;
    }

    .sidebar__nav {
      padding-inline-start: var(--space_4);
    }

    .main {
      flex: 1;
      padding-inline-end: var(--space_16);
    }
  }

  /* Menu overlay: a panel as wide as the sidebar, full width on small phones */
  .menu-dialog {
    position: fixed;
    inset: 0 auto 0 0;
    inline-size: min(var(--sidebar-width), 100%);
    max-inline-size: none;
    block-size: 100dvh;
    max-block-size: none;
    margin: 0;
    padding: 0 var(--space_16) var(--space_32) calc(var(--brand-bar-width) + var(--space_16));
    overflow-y: auto;
    border: 0;
    border-inline-end: var(--border_s) solid var(--tiles_border);
    background: var(--main_background);
    color: var(--text_default);
  }

  .menu-dialog::before {
    content: '';
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: var(--brand-bar-width);
    background: var(--decorative_brand);
  }

  .menu-dialog::backdrop {
    background: rgb(42 37 32 / 0.4); /* text_default at 40% */
  }

  .menu-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space_16);
    margin-block-end: var(--space_12);
  }

  .menu-dialog :global(.nav-menu) {
    max-inline-size: none;
  }

  :global(html:has(.menu-dialog[open])) {
    overflow: hidden;
  }
</style>
