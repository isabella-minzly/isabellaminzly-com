---
// Figma "Image": an image centred in a box with the contrast background.
// From 760 the box keeps the frame's minimum height and the image its Figma size.
// Below that the box fills the width and its height follows the image.
// With a caption it is Figma "Figure": the box with the caption 8px below it.
// Content passed as children replaces the image (HTML figures such as the Mandala diagram legend).
import type { ImageMetadata } from 'astro';
import CaseImage from './CaseImage.astro';

interface Props {
  /** A raster image; pass either src or svg */
  src?: ImageMetadata;
  /** Raw SVG markup for vector mock-ups (import with ?raw) */
  svg?: string;
  alt: string;
  /** Display width of the image in the 1680 frame, in px */
  width: number;
  /** Width of the box in the 1680 frame, in px; omit to fill */
  boxWidth?: number;
  /** Minimum box height from 760 up, in px */
  minHeight?: number;
  /** The image fills the box edge to edge, with no padding (Accessibility for Inclusion hero) */
  bleed?: boolean;
  /** The box keeps its light colours in dark mode */
  lightBox?: boolean;
  /** 32 padding from 760, as the Mandala hero, diagram and typography boxes */
  spacious?: boolean;
  eager?: boolean;
  caption?: string;
  class?: string;
}

const { src, svg, alt, width, boxWidth, minHeight = 340, bleed = false, lightBox = false, spacious = false, eager = false, caption, class: className } = Astro.props;
const custom = Astro.slots.has('default');
const boxClass = ['case-figure', { 'case-figure--bleed': bleed, 'case-figure--spacious': spacious, 'case-figure--custom': custom, 'theme-light': lightBox }];
const style = `--box-width: ${boxWidth ? `${boxWidth}px` : '100%'}; --box-min-height: ${minHeight}px; --image-width: ${width}px`;
---

{
  caption ? (
    <figure class:list={['case-figure-group', className]} style={style}>
      <div class:list={boxClass}>
        {custom ? <slot /> : <CaseImage src={src} svg={svg} alt={alt} width={width} eager={eager} />}
      </div>
      <figcaption class="text-captions">{caption}</figcaption>
    </figure>
  ) : (
    <figure class:list={[...boxClass, className]} style={style}>
      {custom ? <slot /> : <CaseImage src={src} svg={svg} alt={alt} width={width} eager={eager} />}
    </figure>
  )
}

<style>
  .case-figure-group {
    display: flex;
    flex-direction: column;
    gap: var(--space_8);
    inline-size: 100%;
    max-inline-size: var(--box-width);
  }

  .case-figure {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 100%;
    max-inline-size: var(--box-width);
    padding: var(--space_16);
    background: var(--contrast_background);
    border: var(--border_s) solid var(--tiles_border);
    border-radius: var(--radius_xl);
  }

  .case-figure :global(.case-figure__image) {
    inline-size: var(--image-width);
    max-inline-size: 100%;
  }

  .case-figure :global(.case-figure__svg svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .case-figure--bleed {
    padding: 0;
    overflow: hidden;
  }

  /* The picture element is the flex item, so it has to fill the box for the image to */
  .case-figure--bleed :global(picture) {
    flex: 1;
  }

  .case-figure--bleed :global(.case-figure__image) {
    inline-size: 100%;
  }

  /* Custom content sets its own width inside the box */
  .case-figure--custom {
    color: var(--text_default);
  }

  @media (width >= 47.5em) {
    .case-figure:not(.case-figure--bleed) {
      min-block-size: var(--box-min-height);
    }

    .case-figure--spacious {
      padding: var(--space_32);
    }
  }
</style>
