---
// Figma components "Button Solid" and "Button Outlined" (Default, Hover, Focus, Pressed, Disabled).
// Renders a link when given href, otherwise a button.
// disabledReason makes it a disabled button with a tooltip that says why (see Tooltip.astro).
import type { HTMLAttributes } from 'astro/types';
import Tooltip from './Tooltip.astro';

type Props = ((HTMLAttributes<'a'> & { href: string }) | (HTMLAttributes<'button'> & { href?: undefined })) & {
  disabledReason?: string;
  variant?: 'solid' | 'outlined';
};

const { class: classProp, href, disabledReason, variant = 'solid', ...attrs } = Astro.props;
const className = [variant === 'outlined' && 'button--outlined', classProp];
// A link without href cannot take focus, so a disabled button is always a button
const Tag = href && !disabledReason ? 'a' : 'button';
const tooltipId = disabledReason ? `tooltip-${crypto.randomUUID().slice(0, 8)}` : undefined;
---

{
  disabledReason ? (
    <Tooltip id={tooltipId!} text={disabledReason}>
      <button class:list={['button', 'text-label', className]} type="button" aria-disabled="true" aria-describedby={tooltipId} {...attrs}>
        <slot />
      </button>
    </Tooltip>
  ) : (
    <Tag class:list={['button', 'text-label', className]} href={href} type={href ? undefined : 'button'} {...attrs}>
      <slot />
    </Tag>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 3rem;
    padding: var(--space_12) var(--space_24);
    border: 0;
    border-radius: var(--radius_xl);
    background: var(--accent_default);
    color: var(--text_label);
    text-decoration: none;
    cursor: pointer;
  }

  .button:hover {
    background: var(--accent_hover);
  }

  .button:active {
    background: var(--accent_pressed);
  }

  .button:focus-visible {
    outline: var(--border_focus) solid var(--accent_default);
    outline-offset: var(--space_2);
  }

  /* Outlined: 2px border and label in the accent colour, contrast background on hover and press */
  .button--outlined {
    border: var(--border_focus) solid var(--accent_default);
    background: transparent;
    color: var(--accent_default);
  }

  .button--outlined:hover {
    border-color: var(--accent_hover);
    background: var(--contrast_background);
    color: var(--accent_hover);
  }

  .button--outlined:active {
    border-color: var(--accent_pressed);
    background: var(--contrast_background);
    color: var(--accent_pressed);
  }

  /* .button doubles the specificity so this wins over the solid disabled rule below */
  .button.button--outlined[aria-disabled='true'],
  .button.button--outlined[aria-disabled='true']:hover,
  .button.button--outlined[aria-disabled='true']:active {
    border-color: var(--disabled);
    background: transparent;
    color: var(--disabled);
  }

  /* Disabled never changes on hover, press or focus, or it would look enabled.
     On keyboard focus the tooltip appearing is the visible change. */
  .button[aria-disabled='true'],
  .button[aria-disabled='true']:hover,
  .button[aria-disabled='true']:active {
    background: var(--disabled);
    cursor: default;
  }

  .button[aria-disabled='true']:focus-visible {
    outline: none;
  }
</style>
