---
// Figma component set "Footer", one variant per breakpoint:
// 320 to 599 (everything stacked and centred), 600 to 759 (stacked, links in a row),
// 760 to 1279 (copyright above the credit, links beside the credit),
// 1280 and up (one row, copyright lined up with the main content).
import Link from './Link.astro';
import Frog from './Frog.astro';
import { footerLinks, newTab, newTabText } from '../data/navigation';
import { url } from '../utils/url';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__bar">
    <div class="footer__about">
      <p class="footer__copyright text-footer">© {year} Isabella Minzly. All rights reserved.</p>
      <p class="footer__credit text-footer">
        <span>Happily built with Claude, Figma and the</span>
        <Link href={footerLinks.figmaConsoleMcp} {...newTab}>Figma Console MCP<span class="visually-hidden">{newTabText}</span></Link>
      </p>
    </div>
    <ul class="footer__links" role="list">
      <li><Link href={footerLinks.linkedIn} {...newTab}>LinkedIn<span class="visually-hidden">{newTabText}</span></Link></li>
      <li><Link href={url(footerLinks.accessibilityStatement)}>Accessibility statement</Link></li>
    </ul>
  </div>
  <Frog class="footer__frog" />
</footer>

<style>
  .footer {
    position: relative;
    padding-block-start: var(--space_40);
  }

  .footer__bar {
    display: flex;
    flex-direction: column;
    background: var(--contrast_background);
    border-block-start: var(--border_s) solid var(--tiles_border);
  }

  .footer__about {
    display: flex;
    flex-direction: column;
  }

  /* 320 to 599: three 80 rows, the credit and the links stacked inside theirs */
  .footer__copyright,
  .footer__credit,
  .footer__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space_8);
    min-block-size: 5rem;
    margin: 0;
    text-align: center;
  }

  /* Room for the small frog on both sides, so the centred line stays centred */
  .footer__copyright {
    padding-inline: var(--space_64);
  }

  .footer__credit {
    padding-inline: var(--space_8);
  }

  .footer__links {
    padding-inline: var(--space_24);
    list-style: none;
  }

  /* Small frog inside the bar on narrow screens, clear of the centred text */
  .footer__frog {
    position: absolute;
    inset-block-start: 13px;
    inset-inline-end: var(--space_16);
    inline-size: 40px;
    block-size: 68px;
  }

  /* 600 to 759: the credit and the links each on one 40 row */
  @media (width >= 37.5em) {
    .footer__credit,
    .footer__links {
      flex-direction: row;
      flex-wrap: wrap;
      min-block-size: 2.5rem;
    }
  }

  /* 760 and up: links beside the credit, full-size frog sitting on the bar */
  @media (width >= 47.5em) {
    .footer__bar {
      flex-direction: row;
      align-items: flex-end;
    }

    .footer__about {
      flex: 1;
    }

    .footer__credit,
    .footer__links {
      column-gap: var(--space_10);
    }

    .footer__credit {
      padding-inline: 0;
    }

    .footer__frog {
      inset-block-start: calc(var(--space_24) * -1);
      inline-size: 63px;
      block-size: 106px;
    }
  }

  /* 1280 and up: one row, copyright lines up with the main content (400 in Figma: sidebar plus its gap),
     and stays aligned when the reader enlarges text. Below about 1600 the links move to a second row. */
  @media (width >= 80em) {
    .footer__bar {
      flex-wrap: wrap;
      align-items: center;
      column-gap: calc(var(--space_24) * 3); /* 72 between the credit and the links, as in Figma */
      padding-inline: calc(var(--sidebar-width) + var(--space_24)) 96px; /* keeps the links clear of the frog */
    }

    .footer__about {
      flex: 0 1 auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      column-gap: var(--space_4);
      min-block-size: 5rem;
    }

    .footer__copyright,
    .footer__credit,
    .footer__links {
      justify-content: flex-start;
      padding-inline: 0;
      text-align: start;
    }

    .footer__copyright,
    .footer__credit {
      min-block-size: 0;
    }
  }
</style>
